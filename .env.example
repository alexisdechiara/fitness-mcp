# Credentials amont, conservés uniquement sur le serveur
LYFTA_API_KEY=
LYFTA_BASE_URL=https://my.lyfta.app
YAZIO_USERNAME=
YAZIO_PASSWORD=
# Un compte Yazio créé avec Google peut ne pas avoir de mot de passe compatible.
# Dans ce cas, laisser les deux variables vides : le MCP et Lyfta restent disponibles.

# Contrôle d'accès MCP. OAuth est le mode de production recommandé pour Claude.
MCP_AUTH_MODE=oauth

# URLs OAuth publiques. L'issuer est une origine seule (sans chemin) et HTTPS est obligatoire en production.
# La ressource doit correspondre exactement à celle envoyée par Claude.
OAUTH_ISSUER_URL=https://fitness.alexisdechiara.fr
OAUTH_RESOURCE_URL=https://fitness.alexisdechiara.fr/mcp

# Store OAuth persistant, prévu pour un seul conteneur.
OAUTH_STORE_PATH=/data/oauth-store.json

# Dynamic Client Registration, réglage recommandé pour la compatibilité Claude actuelle.
OAUTH_DCR_ENABLED=true
OAUTH_ALLOWED_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback
OAUTH_MAX_DYNAMIC_CLIENTS=100

# Durées de vie OAuth, en secondes.
OAUTH_ACCESS_TOKEN_TTL_SECONDS=900
OAUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
OAUTH_AUTH_CODE_TTL_SECONDS=90
OAUTH_SESSION_TTL_SECONDS=28800

# Compte humain protégeant l'écran de consentement. Utiliser des secrets de production uniques.
FITNESS_ADMIN_USERNAME=
FITNESS_ADMIN_PASSWORD=

# Client Claude confidentiel pré-enregistré facultatif. Laisser les deux champs vides avec DCR.
# Si elle est définie, la valeur de CLAUDE_CLIENT_SECRET doit compter au moins 32 caractères.
CLAUDE_CLIENT_ID=
CLAUDE_CLIENT_SECRET=

# Mode Bearer fixe historique : choisir MCP_AUTH_MODE=bearer et générer au moins 32 octets aléatoires.
MCP_ACCESS_TOKEN=

# HTTP
PORT=3000
NODE_ENV=production
LOG_LEVEL=info
MCP_ALLOWED_HOSTS=fitness.alexisdechiara.fr,localhost,127.0.0.1
# Uniquement pour un client navigateur direct ; utiliser des origines complètes.
# Les clients serveur-à-serveur n'envoient normalement pas d'Origin.
MCP_ALLOWED_ORIGINS=
# Dokploy place normalement un proxy Traefik devant le conteneur. Mettre 0 en accès direct.
TRUST_PROXY_HOPS=1

# Fiabilité et bornes d'agrégation
UPSTREAM_TIMEOUT_MS=15000
UPSTREAM_RETRIES=2
UPSTREAM_CONCURRENCY=4
FITNESS_MAX_RANGE_DAYS=366
FITNESS_MAX_WORKOUTS=1000
