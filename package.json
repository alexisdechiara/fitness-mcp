{
  "name": "fitness-mcp",
  "version": "0.1.0",
  "description": "Read-only remote MCP server aggregating Lyfta training and Yazio nutrition data",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexisdechiara/fitness-mcp.git"
  },
  "homepage": "https://github.com/alexisdechiara/fitness-mcp#readme",
  "bugs": {
    "url": "https://github.com/alexisdechiara/fitness-mcp/issues"
  },
  "keywords": [
    "fitness",
    "lyfta",
    "mcp",
    "model-context-protocol",
    "yazio"
  ],
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.16.0",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "yazio": "1.1.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.2.1",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "license": "MIT"
}
